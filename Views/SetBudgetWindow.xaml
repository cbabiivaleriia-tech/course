<Window x:Class="WeeklyShoppingListWPF.Views.SetBudgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Встановлення бюджету"
        Width="420"
        Height="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}">

    <Border Padding="28">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="Бюджет на покупки"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextBrush}"/>
                <TextBlock Text="Вкажіть максимальну суму, яку плануєте витратити"
                           FontSize="13"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Тіло вікна -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <TextBlock Text="Сума бюджету (грн) *"
                           FontSize="13"
                           FontWeight="Medium"
                           Foreground="{DynamicResource TextBrush}"
                           Margin="0,0,0,6"/>

                <TextBox x:Name="BudgetTextBox"
                         Height="42"
                         FontSize="16"
                         FontWeight="SemiBold"
                         KeyDown="BudgetTextBox_KeyDown"/>

                <!-- Швидкі кнопки -->
                <TextBlock Text="Швидкий вибір:"
                           FontSize="12"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Margin="0,14,0,6"/>

                <WrapPanel>
                    <Button Content="500 грн" Margin="0,0,6,6" Padding="10,5" Style="{DynamicResource SecondaryButtonStyle}" Click="QuickBudget_Click"/>
                    <Button Content="1 000 грн" Margin="0,0,6,6" Padding="10,5" Style="{DynamicResource SecondaryButtonStyle}" Click="QuickBudget_Click"/>
                    <Button Content="2 000 грн" Margin="0,0,6,6" Padding="10,5" Style="{DynamicResource SecondaryButtonStyle}" Click="QuickBudget_Click"/>
                    <Button Content="3 000 грн" Margin="0,0,6,6" Padding="10,5" Style="{DynamicResource SecondaryButtonStyle}" Click="QuickBudget_Click"/>
                    <Button Content="5 000 грн" Margin="0,0,6,6" Padding="10,5" Style="{DynamicResource SecondaryButtonStyle}" Click="QuickBudget_Click"/>
                </WrapPanel>

                <!-- Повідомлення про помилку -->
                <TextBlock x:Name="ErrorTextBlock"
                           Foreground="{DynamicResource DangerBrush}"
                           FontSize="12"
                           Visibility="Collapsed"
                           Margin="0,6,0,0"/>
            </StackPanel>

            <!-- Кнопки -->
            <Grid Grid.Row="2" Margin="0,16,0,0">
                <Button Content="Скинути ліміт"
                        HorizontalAlignment="Left"
                        Foreground="{DynamicResource SecondaryTextBrush}"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="ResetButton_Click"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Скасувати"
                            Style="{DynamicResource SecondaryButtonStyle}"
                            Width="95"
                            Height="38"
                            Margin="0,0,10,0"
                            IsCancel="True"
                            Click="CancelButton_Click"/>
                    <Button Content="Зберегти"
                            Style="{DynamicResource PrimaryButtonStyle}"
                            Width="105"
                            Height="38"
                            IsDefault="True"
                            Click="SaveButton_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
