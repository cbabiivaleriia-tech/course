<Page x:Class="WeeklyShoppingListWPF.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource BackgroundBrush}"
      Loaded="Page_Loaded">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="36,28,36,28">
            <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                <!-- Заголовок -->
                <TextBlock Text="Налаштування"
                           Style="{DynamicResource PageTitleStyle}"/>

                <TextBlock Text="Зовнішній вигляд програми та інформація про профіль"
                           Style="{DynamicResource PageSubtitleStyle}"
                           Margin="0,4,0,24"/>

                <!-- Блок теми оформлення -->
                <Border Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="24"
                        Margin="0,0,0,20">

                    <StackPanel>
                        <TextBlock Text="🎨  Тема оформлення"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"
                                   Margin="0,0,0,16"/>

                        <RadioButton x:Name="DarkThemeRadioButton"
                                     Content="Темна тема (сучасна графітова нічна палітра)"
                                     FontSize="15"
                                     IsChecked="True"
                                     Margin="0,0,0,14"
                                     Checked="DarkTheme_Checked"/>

                        <RadioButton x:Name="LightThemeRadioButton"
                                     Content="Світла тема (м'яка денна палітра для комфортного читання)"
                                     FontSize="15"
                                     Checked="LightTheme_Checked"/>
                    </StackPanel>
                </Border>

                <!-- Блок облікового запису -->
                <Border Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="24"
                        Margin="0,0,0,20">

                    <StackPanel>
                        <TextBlock Text="👤  Обліковий запис користувача"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"
                                   Margin="0,0,0,16"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Ім'я користувача:" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="14"/>
                            <TextBlock Grid.Column="1" x:Name="ProfileNameTextBlock" Text="—" Foreground="{DynamicResource TextBrush}" FontWeight="Medium" FontSize="14"/>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Логін в системі:" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="14"/>
                            <TextBlock Grid.Column="1" x:Name="ProfileUsernameTextBlock" Text="—" Foreground="{DynamicResource TextBrush}" FontWeight="Medium" FontSize="14"/>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Встановлений бюджет:" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="14"/>
                            <TextBlock Grid.Column="1" x:Name="ProfileBudgetTextBlock" Text="—" Foreground="{DynamicResource PrimaryBrush}" FontWeight="Bold" FontSize="14"/>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Дата реєстрації:" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="14"/>
                            <TextBlock Grid.Column="1" x:Name="ProfileCreatedTextBlock" Text="—" Foreground="{DynamicResource TextBrush}" FontSize="14"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Блок інформації про програму -->
                <Border Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="24">

                    <StackPanel>
                        <TextBlock Text="ℹ️  Про програму"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"
                                   Margin="0,0,0,12"/>

                        <TextBlock Text="Курсова робота: «Розробка графічного додатку планування щотижневих покупок»"
                                   FontSize="14"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource TextBrush}"
                                   Margin="0,0,0,6"/>

                        <TextBlock Text="Технології: .NET, WPF, C#, JSON-сховище, PBKDF2-SHA256 криптографічний захист паролів, динамічна зміна тем."
                                   FontSize="13"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>

</Page>
