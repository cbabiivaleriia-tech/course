<Window x:Class="WeeklyShoppingListWPF.Views.AddPurchaseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Додати покупку"
        Width="460"
        Height="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}">

    <Border Padding="28">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="Нова покупка"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextBrush}"/>
                <TextBlock Text="Введіть дані про товар для списку"
                           FontSize="13"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Форма -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Назва товару -->
                    <TextBlock Text="Назва товару *"
                               Foreground="{DynamicResource TextBrush}"
                               FontWeight="Medium"
                               FontSize="13"
                               Margin="0,0,0,6"/>
                    <TextBox x:Name="NameTextBox"
                             Height="40"
                             Margin="0,0,0,16"/>

                    <!-- Кількість та Одиниця виміру -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Кількість *"
                                       Foreground="{DynamicResource TextBrush}"
                                       FontWeight="Medium"
                                       FontSize="13"
                                       Margin="0,0,0,6"/>
                            <TextBox x:Name="QuantityTextBox"
                                     Text="1"
                                     Height="40"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Одиниця"
                                       Foreground="{DynamicResource TextBrush}"
                                       FontWeight="Medium"
                                       FontSize="13"
                                       Margin="0,0,0,6"/>
                            <ComboBox x:Name="UnitComboBox"
                                      Height="40"
                                      VerticalContentAlignment="Center"
                                      SelectedIndex="0">
                                <ComboBoxItem Content="шт"/>
                                <ComboBoxItem Content="кг"/>
                                <ComboBoxItem Content="л"/>
                                <ComboBoxItem Content="уп"/>
                                <ComboBoxItem Content="пач"/>
                                <ComboBoxItem Content="г"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <!-- Ціна за одиницю -->
                    <TextBlock Text="Ціна за одиницю (грн) *"
                               Foreground="{DynamicResource TextBrush}"
                               FontWeight="Medium"
                               FontSize="13"
                               Margin="0,0,0,6"/>
                    <TextBox x:Name="PriceTextBox"
                             Text="0"
                             Height="40"
                             Margin="0,0,0,16"/>

                    <!-- Категорія -->
                    <TextBlock Text="Категорія"
                               Foreground="{DynamicResource TextBrush}"
                               FontWeight="Medium"
                               FontSize="13"
                               Margin="0,0,0,6"/>
                    <ComboBox x:Name="CategoryComboBox"
                              Height="40"
                              VerticalContentAlignment="Center"
                              SelectedIndex="0"
                              Margin="0,0,0,10">
                        <ComboBoxItem Content="Продукти"/>
                        <ComboBoxItem Content="Овочі та фрукти"/>
                        <ComboBoxItem Content="Молочне"/>
                        <ComboBoxItem Content="М'ясо та риба"/>
                        <ComboBoxItem Content="Напої"/>
                        <ComboBoxItem Content="Побутова хімія"/>
                        <ComboBoxItem Content="Гігієна"/>
                        <ComboBoxItem Content="Інше"/>
                    </ComboBox>

                    <!-- Повідомлення про помилку -->
                    <TextBlock x:Name="ErrorTextBlock"
                               Foreground="{DynamicResource DangerBrush}"
                               FontSize="13"
                               TextWrapping="Wrap"
                               Visibility="Collapsed"
                               Margin="0,6,0,0"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Кнопки керування -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,20,0,0">
                <Button Content="Скасувати"
                        Style="{DynamicResource SecondaryButtonStyle}"
                        Width="110"
                        Height="40"
                        Margin="0,0,12,0"
                        IsCancel="True"
                        Click="CancelButton_Click"/>
                <Button Content="Додати"
                        Style="{DynamicResource PrimaryButtonStyle}"
                        Width="120"
                        Height="40"
                        IsDefault="True"
                        Click="AddButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
