<Page x:Class="WeeklyShoppingListWPF.Views.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource BackgroundBrush}"
      Loaded="Page_Loaded">

    <Grid Margin="36,28,36,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. ВІТАЛЬНИЙ ЗАГОЛОВОК -->
        <StackPanel Grid.Row="0">
            <TextBlock x:Name="WelcomeTextBlock"
                       Text="Ласкаво просимо!"
                       Style="{DynamicResource PageTitleStyle}"/>

            <TextBlock Text="Ваш персональний помічник для планування та контролю витрат"
                       Style="{DynamicResource PageSubtitleStyle}"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- 2. ГОЛОВНИЙ БАНЕР -->
        <Border Grid.Row="1"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="36,28"
                Margin="0,24,0,24">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Плануйте щотижневі покупки розумно 🛍️"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}"
                               Margin="0,0,0,8"/>

                    <TextBlock Text="Встановлюйте ліміти бюджету, відстежуйте залишок коштів та зберігайте всі виконані покупки в зручному архіві."
                               FontSize="14"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextWrapping="Wrap"
                               MaxWidth="550"
                               Margin="0,0,0,20"/>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="🛒   Відкрити список покупок"
                                Width="230"
                                Height="44"
                                FontSize="14"
                                Margin="0,0,12,0"
                                Style="{DynamicResource PrimaryButtonStyle}"
                                Click="OpenShoppingList_Click"/>

                        <Button Content="📦   Переглянути архів"
                                Width="180"
                                Height="44"
                                FontSize="14"
                                Style="{DynamicResource SecondaryButtonStyle}"
                                Click="OpenArchive_Click"/>
                    </StackPanel>
                </StackPanel>

                <!-- Декоративна іконка -->
                <Border Grid.Column="1"
                        Background="{DynamicResource BadgeBackgroundBrush}"
                        CornerRadius="45"
                        Width="90"
                        Height="90"
                        VerticalAlignment="Center"
                        Margin="20,0,10,0">
                    <TextBlock Text="🛒"
                               FontSize="44"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>

        <!-- 3. ІНФОРМАЦІЙНІ КАРТКИ МОЖЛИВОСТЕЙ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Картка 1: Бюджет -->
            <Border Grid.Column="0"
                    Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20">
                <StackPanel>
                    <TextBlock Text="💰" FontSize="28" Margin="0,0,0,10"/>
                    <TextBlock Text="Контроль бюджету"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"
                               Margin="0,0,0,6"/>
                    <TextBlock Text="Встановіть ліміт витрат та слідкуйте за залишком у реальному часі. Програма попередить про перевищення."
                               FontSize="13"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Картка 2: Архів покупок -->
            <Border Grid.Column="2"
                    Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20">
                <StackPanel>
                    <TextBlock Text="📦" FontSize="28" Margin="0,0,0,10"/>
                    <TextBlock Text="Архів покупок"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"
                               Margin="0,0,0,6"/>
                    <TextBlock Text="Всі куплені товари потрапляють до архіву. Ви завжди можете переглянути історію витрат або відновити товар."
                               FontSize="13"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Картка 3: Безпека облікових записів -->
            <Border Grid.Column="4"
                    Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20">
                <StackPanel>
                    <TextBlock Text="🔐" FontSize="28" Margin="0,0,0,10"/>
                    <TextBlock Text="Захист даних"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"
                               Margin="0,0,0,6"/>
                    <TextBlock Text="Авторизація з криптографічним стандартом PBKDF2-SHA256 та сіллю. Окремі списки для кожного користувача."
                               FontSize="13"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>

</Page>
