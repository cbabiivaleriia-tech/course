<Window x:Class="WeeklyShoppingListWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Weekly Shopping List"
        Width="1140"
        Height="720"
        MinWidth="900"
        MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ЛІВА ПАНЕЛЬ НАВІГАЦІЇ ТА ПРОФІЛЮ -->
        <Border Grid.Column="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="0,0,1,0">

            <Grid Margin="18,20,18,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 1. ЛОГОТИП -->
                <StackPanel Grid.Row="0" Margin="4,6,0,20">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="SHOPPING "
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock Text="LIST"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryBrush}"/>
                    </StackPanel>
                    <TextBlock Text="Smart Weekly Planner"
                               FontSize="11"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <!-- 2. КАРТКА ПОТОЧНОГО КОРИСТУВАЧА -->
                <Border Grid.Row="1"
                        Background="{DynamicResource BackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12,10"
                        Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="{DynamicResource BadgeBackgroundBrush}"
                                CornerRadius="18"
                                Width="34"
                                Height="34"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="UserInitialTextBlock"
                                       Text="👤"
                                       FontSize="15"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="UserDisplayNameTextBlock"
                                       Text="Користувач"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="UsernameTextBlock"
                                       Text="@user"
                                       FontSize="11"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 3. НАВІГАЦІЙНІ КНОПКИ -->
                <StackPanel Grid.Row="2">
                    <Button x:Name="HomeNavButton"
                            Content="🏠   Головна"
                            Style="{DynamicResource NavigationButtonStyle}"
                            Height="44"
                            Margin="0,0,0,8"
                            Click="HomeButton_Click"/>

                    <Button x:Name="ShoppingListNavButton"
                            Content="🛒   Список покупок"
                            Style="{DynamicResource NavigationButtonStyle}"
                            Height="44"
                            Margin="0,0,0,8"
                            Click="ShoppingListButton_Click"/>

                    <!-- Кнопка архіву перед налаштуваннями -->
                    <Button x:Name="ArchiveNavButton"
                            Content="📦   Архів покупок"
                            Style="{DynamicResource NavigationButtonStyle}"
                            Height="44"
                            Margin="0,0,0,8"
                            Click="ArchiveButton_Click"/>

                    <Button x:Name="SettingsNavButton"
                            Content="⚙   Налаштування"
                            Style="{DynamicResource NavigationButtonStyle}"
                            Height="44"
                            Click="SettingsButton_Click"/>
                </StackPanel>

                <!-- 4. НИЖНІЙ БЛОК: КНОПКА ВИХОДУ ТА ВЕРСІЯ -->
                <StackPanel Grid.Row="3">
                    <Button Content="🚪   Вийти з акаунта"
                            Style="{DynamicResource DangerButtonStyle}"
                            Height="38"
                            Margin="0,0,0,14"
                            Click="LogoutButton_Click"/>

                    <TextBlock Text="Weekly Shopping List • 2026"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="11"
                               HorizontalAlignment="Center"/>
                </StackPanel>

            </Grid>
        </Border>

        <!-- ОСНОВНА ОБЛАСТЬ КОНТЕНТУ -->
        <Frame x:Name="MainFrame"
               Grid.Column="1"
               NavigationUIVisibility="Hidden"/>

    </Grid>
</Window>